{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/schema.json",
  "productName": "YT Downloader",
  "version": "0.1.0",
  "identifier": "com.ytdownloader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YT Downloader",
        "width": 800,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "YouTube video and audio downloader",
    "longDescription": "Desktop application for downloading YouTube videos and audio files with quality options."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNjMyMTREMjU3NzhCNUQKUldSZGkzY2xUU0ZqYkhjL2lGMjdId1dVSDZxbTVzZkpmUkNJazFXdkM3R0N3d2lQYTJ2L3pJOTkK",
      "endpoints": [
        "https://github.com/NotionMe/yt-downloads/releases/latest/download/latest.json"
      ]
    }
  }
}
